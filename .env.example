# =============================================
# Earth Guardians - Environment Configuration
# =============================================

# Supabase Configuration
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_KEY=your-service-key-here

# Development Settings
VITE_DEV_HOST=false
VITE_HTTPS=false
VITE_API_URL=http://localhost:4000

# P2P Configuration
VITE_STUN_SERVER_1=stun:stun.l.google.com:19302
VITE_STUN_SERVER_2=stun:stun1.l.google.com:19302
VITE_RELAY_ENABLED=true
VITE_MAX_CONNECTIONS=50

# Logging
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEBUG=false

# Performance
VITE_WASM_CHUNK_SIZE=65536
VITE_COMPRESSION_ENABLED=true

# Feature Flags
VITE_FEATURE_REALTIME=true
VITE_FEATURE_OFFLINE=true
VITE_FEATURE_P2P=true
VITE_FEATURE_ANALYTICS=false

# Security
VITE_CSP_ENABLED=true
VITE_CSP_REPORT_URI=/api/csp-report

# Analytics
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Database (for migrations)
SUPABASE_DB_PASSWORD=postgres
POSTGRES_PASSWORD=postgres

# JWT Secrets
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
REALTIME_JWT_SECRET=another-secret-jwt-token-with-at-least-32-characters-long

# SMTP (for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# InfluxDB
INFLUXDB_TOKEN=earth-guardians-token

# Mobile
CAPACITOR_IOS_SCHEME=earth-guardians
CAPACITOR_ANDROID_SCHEME=earth-guardians