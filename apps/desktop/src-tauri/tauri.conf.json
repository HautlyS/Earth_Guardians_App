{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../../web",
    "distDir": "../../web/dist"
  },
  "package": {
    "productName": "Earth Guardians",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "open": true
      },
      "notification": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["$APP/**", "$DOCUMENT/**", "$HOME/**"]
      },
      "dialog": {
        "all": true
      },
      "os": {
        "all": true
      },
      "process": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.earthguardians.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": [],
      "copyright": "Copyright 2024 Earth Guardians",
      "category": "Productivity",
      "shortDescription": "Earth Guardians NGO Platform",
      "longDescription": "A Neo-brutalist collaborative platform for Earth Guardians NGO with P2P, WASM, and decentralized storage."
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Earth Guardians",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "macOSPrivateApi": true
  }
}
