{
  "name": "earth-guardians-app",
  "version": "1.0.0",
  "description": "Earth Guardians - Decentralized P2P Collaborative Platform with Quantum Encryption",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:node": "tsc --project tsconfig.node.json",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "keywords": [
    "p2p",
    "decentralized",
    "quantum",
    "encryption",
    "supabase",
    "collaborative",
    "earth-guardians"
  ],
  "author": "Earth Guardians Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.10.0"
  }
}
